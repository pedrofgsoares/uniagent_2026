# Copiar para .env e preencher. O .env nunca é versionado nem entra na imagem Docker.
#
# Dev: router da Hugging Face Inference Providers (OpenAI-compatible).
# Usar um token fine-grained DEDICADO, apenas com a permissão
# `inference.serverless.write`. Nunca reutilizar um token pessoal amplo.
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b

# Opcional. Para o gpt-oss: low | medium | high.
OPENAI_REASONING_EFFORT=low
