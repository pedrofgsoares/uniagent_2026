FROM python:3.12-slim

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UNIAGENT_LOAD_DOTENV=0 \
    OPENBLAS_NUM_THREADS=4 \
    OMP_NUM_THREADS=4

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir ".[retrieval,test]"
COPY tests/ ./tests/
ENTRYPOINT ["uniagent-retrieve"]
